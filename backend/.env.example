PORT=8080
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://pump:pump@localhost:5432/pumpfun
SNAPSHOT_INTERVAL_MS=5000
INGEST_INTERVAL_MS=1200
# HELIUS_API_KEY=your_key_here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
# Optional seed lists. Leave empty for full automatic Pump.fun discovery.
HELIUS_MONITORED_WALLETS=
# Extra global addresses to poll on top of the built-in Pump.fun program IDs.
HELIUS_GLOBAL_ADDRESSES=
HELIUS_MAX_TRACKED_WALLETS=3000
HELIUS_MAX_TRACKED_MINTS=5000
HELIUS_SIGNATURE_LIMIT=50
# HELIUS_WEBHOOK_SECRET=your_webhook_secret

# ── Ingestion source toggle ───────────────────────────────────────────────
# Which provider powers launch + trade ingestion: "pumpportal" or "bitquery".
INGEST_SOURCE=pumpportal

# Bitquery (used when INGEST_SOURCE=bitquery). OAuth2 v2 Bearer token.
# BITQUERY_API_KEY=your_bitquery_bearer_token

# PumpPortal (used when INGEST_SOURCE=pumpportal).
# New-token stream is FREE and needs no key. The trade stream is METERED
# (0.01 SOL per 10k messages) and requires this key + a linked wallet funded
# with >= 0.02 SOL. Leave unset to stream launches only (no trade tracking).
# PUMPPORTAL_API_KEY=your_pumpportal_api_key
# SOL price used to convert PumpPortal's marketCapSol into USD.
SOL_USD_ESTIMATE=150

# Cost control for the metered PumpPortal trade stream. The budget is spent on
# the coins the strategy can act on (held positions + young/cheap entry
# candidates) first. Lower these to cut SOL burn; raise for wider coverage.
MAX_TRADE_SUBSCRIPTIONS=200
TRADE_ACTIVE_WINDOW_MS=120000

# PumpFunData historical backfill (scripts/backfill.mjs). One-time purchased
# Parquet history for training/backtesting — NOT used by the live server.
# Get a key at https://pumpfundata.com (connect wallet → buy credits).
# PUMPFUNDATA_API_KEY=pfd_your_key_here

# Full Solana RPC URL (including key) for on-chain checks like Mayhem detection.
# Preferred over Helius/public RPC when set.
# ALCHEMY_API=https://solana-mainnet.g.alchemy.com/v2/your_api_key

# Drop Pump.fun "Mayhem Mode" launches (Token-2022 mints with an AI trading
# agent). Detection uses a getMultipleAccounts RPC call (Alchemy if set, else
# Helius if configured, else public Solana RPC). Set to false to keep them.
FILTER_MAYHEM=true
